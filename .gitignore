# Dependencies and generated caches
node_modules/
.cache/
dist/

# Temporary working files
.tmp-*
*.tmp

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Local full-project backup
backup/

# Local generated reports and temporary rendering files
output/
tmp/

# Local Mailform Pro runtime and private configuration
contact/mailformpro/
contact/mfp.statics/
contact/iplogs/

# Full-resolution supplied photography; publish only prepared web assets.
/img/videos/**/originals/
/img/gallery/originals/
# Local staging masters and unused review drafts; publish selected WebP copies only.
/img/gallery/staged/**/*.png

# Separate analytics packages and private runtime data
/analytics-service-dist/
/analytics-portal-dist/
/analytics-service/private/config.php
/analytics-service/private/data/
/analytics-service/private/pages.json
