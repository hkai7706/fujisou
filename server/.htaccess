# PRODUCTION: install at the www.fujisou-ainos.com document root.
# For the sub.jp test folder use .htaccess.preview instead.
DirectoryIndex index.html index.shtml
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Descriptive blog URLs: preserve existing article addresses with permanent redirects.
  RewriteRule ^staffblog/-nhk\.shtml$ staffblog/single-person-housing-rental-challenges.shtml [R=301,L]
  RewriteRule ^staffblog/-100\.shtml$ staffblog/toyama-inherited-vacant-home-renovation.shtml [R=301,L]
  RewriteRule ^staffblog/post-937\.shtml$ staffblog/custom-home-mortgage-planning.shtml [R=301,L]
  RewriteRule ^staffblog/post-936\.shtml$ staffblog/mortgage-and-life-financial-planning.shtml [R=301,L]
  RewriteRule ^staffblog/2-10\.shtml$ staffblog/two-story-home-benefits-floor-plan.shtml [R=301,L]
  RewriteRule ^staffblog/post-935\.shtml$ staffblog/hotel-style-home-floor-plan.shtml [R=301,L]
  RewriteRule ^staffblog/post-934\.shtml$ staffblog/home-building-decision-making.shtml [R=301,L]
  RewriteRule ^staffblog/post-933\.shtml$ staffblog/custom-home-price-differences.shtml [R=301,L]
  RewriteRule ^staffblog/10-1\.shtml$ staffblog/affordable-land-search-tips.shtml [R=301,L]
  RewriteRule ^staffblog/ainos\.shtml$ staffblog/barefoot-living-solid-wood-floors.shtml [R=301,L]
  RewriteRule ^staffblog/5000\.shtml$ staffblog/inherited-vacant-home-opportunities.shtml [R=301,L]
  RewriteRule ^staffblog/post-932\.shtml$ staffblog/building-a-home-without-land.shtml [R=301,L]
  RewriteRule ^staffblog/post-931\.shtml$ staffblog/family-home-design-child-development.shtml [R=301,L]
  RewriteRule ^staffblog/post-930\.shtml$ staffblog/home-design-child-learning.shtml [R=301,L]
  RewriteRule ^staffblog/100\.shtml$ staffblog/retirement-housing-location-risks.shtml [R=301,L]
  RewriteRule ^staffblog/post-929\.shtml$ staffblog/toyama-soundproof-home-renovation.shtml [R=301,L]
  RewriteRule ^staffblog/post-928\.shtml$ staffblog/home-maintenance-after-construction.shtml [R=301,L]
  RewriteRule ^staffblog/post-927\.shtml$ staffblog/home-building-information-research.shtml [R=301,L]
  RewriteRule ^staffblog/post-926\.shtml$ staffblog/house-builder-vs-local-contractor.shtml [R=301,L]
  RewriteRule ^staffblog/post-925\.shtml$ staffblog/when-to-start-building-a-home.shtml [R=301,L]


  # Preserve old tracking cleanup for navigation only. As before, this
  # discards ALL query parameters if a listed tracking parameter is present.
  # Do not redirect form submissions or other non-GET/HEAD requests.
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{QUERY_STRING} (^|&)(_gl|_gcl_au|gclid)=[^&]+ [NC]
  RewriteRule ^ https://www.fujisou-ainos.com%{REQUEST_URI} [R=301,L,QSD]

  # Preserve paths and queries when redirecting hostnames or HTTPS.
  RewriteCond %{HTTP_HOST} ^(?:fujisou-ainos\.sub\.jp|fujisou-ainos\.com)(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://www.fujisou-ainos.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^www\.fujisou-ainos\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://www.fujisou-ainos.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Return a genuine 404 instead of redirecting missing pages to the homepage.
ErrorDocument 404 /404.html

# Parse the .html landing page; existing .shtml handling remains with the host.
<IfModule mod_include.c>
  Options +Includes
  AddOutputFilter INCLUDES .html .shtml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Stable filenames must refresh when their contents are replaced.
  <FilesMatch "\.(?i:jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?i:css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?i:woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(?i:html|htm|shtml|shtm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?i:xml|json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
