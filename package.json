{
  "name": "fujisou-ainos-website",
  "private": true,
  "scripts": {
    "preview": "node tools/serve-ssi.mjs",
    "blog": "node tools/build-blog.mjs",
    "videos": "node tools/build-videos.mjs",
    "gallery:organize": "node tools/organize-gallery-library.mjs --apply",
    "gallery:update": "node tools/manage-gallery.mjs",
    "gallery:build": "node tools/rebuild-gallery.mjs",
    "prepare": "node tools/prepare-html.mjs",
    "optimize": "node tools/optimize-assets.mjs",
    "sitemap": "node tools/generate-sitemap.mjs",
    "check": "node tools/site-check.mjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-deploy.ps1",
    "build:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-deploy.ps1 -IncludeMailform",
    "build:production": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-deploy.ps1 -Production -IncludeMailform"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.5"
  }
}
