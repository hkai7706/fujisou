<!doctype html><html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<!-- Google Analytics 4 -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = window.gtag || gtag;
  (function () {
    var started = false;
    function start() {
      if (started) return;
      started = true;
      window.gtag('js', new Date());
      window.gtag('config', 'G-17DNR9SPL4');
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-17DNR9SPL4';
      document.head.appendChild(script);
    }
    ['pointerdown', 'keydown', 'touchstart'].forEach(function (event) {
      addEventListener(event, start, { once: true, passive: true });
    });
    // Give the first mobile render priority; interaction always begins tracking
    // immediately, while inactive visitors are initialized after the page settles.
    addEventListener('load', function () { setTimeout(start, 10000); }, { once: true });
  }());
</script>
<mt:If name="ainos_listing">
<title><$mt:Var name="ainos_section" encode_html="1"$>｜フジ創アイノス</title>
<link rel="canonical" href="<$mt:Var name="ainos_listing_url" encode_html="1"$>">
<meta name="description" content="フジ創アイノスの<$mt:Var name="ainos_section" encode_html="1"$>をご案内します。">
<meta property="og:title" content="<$mt:Var name="ainos_section" encode_html="1"$>｜フジ創アイノス">
<meta property="og:url" content="<$mt:Var name="ainos_listing_url" encode_html="1"$>">
<meta property="og:type" content="website">
<mt:Else>
